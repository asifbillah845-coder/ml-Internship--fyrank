{
  "rows": 30000,
  "base_decline_rate": 0.5420666666666667,
  "precision_at_10": 0.9,
  "precision_at_50": 0.56,
  "signal_verdicts": {
    "volume": "CONFIRMED",
    "staleness": "MIXED"
  },
  "rule_inputs": [
    "impressions_prev_30d",
    "days_since_last_update"
  ],
  "rule_formula": "0.70 * percentile_rank(log1p(impressions_prev_30d)) + 0.30 * clip(days_since_last_update / 180, 0, 1)",
  "reason_codes": [
    "stale_high_demand",
    "high_prior_demand",
    "stale_low_demand",
    "low_priority"
  ],
  "actions": [
    "refresh",
    "review",
    "monitor"
  ],
  "output": "work/outputs/baseline_action_score.csv"
}